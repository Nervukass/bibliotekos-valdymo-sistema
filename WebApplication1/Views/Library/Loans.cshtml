@model IEnumerable<WebApplication1.Models.LoanViewModel>
@{ ViewData["Title"] = "Išdavimai"; }
<div class="page-heading"><div><p class="eyebrow">KNYGŲ IŠDAVIMAI</p><h1>Išdavimai</h1><p class="page-subtitle">Stebėkite aktyvius knygų išdavimus ir grąžinimus.</p></div><button class="btn btn-dark rounded-pill px-4" data-demo-action="Naujas išdavimas užregistruotas demonstraciniu režimu.">+ Naujas išdavimas</button></div>
<section class="panel table-panel"><div class="table-tools"><div class="catalog-search compact"><span>⌕</span><input data-table-search type="search" placeholder="Ieškoti skaitytojo ar knygos..." /></div><select aria-label="Išdavimų būsena"><option>Visos būsenos</option><option>Aktyvūs</option><option>Pavėluoti</option></select></div><div class="table-responsive"><table><thead><tr><th>Skaitytojas</th><th>Knyga</th><th>Grąžinti iki</th><th>Būsena</th><th></th></tr></thead><tbody>@foreach (var loan in Model) { <tr data-searchable><td><div class="table-person"><div class="avatar">@loan.ReaderInitials</div><strong>@loan.Reader</strong></div></td><td><strong>@loan.BookTitle</strong><small>@loan.Author</small></td><td class="@(loan.Status == "Pavėluota" ? "text-danger" : "")">@loan.DueDate</td><td><span class="status @loan.Status.ToLower().Replace(" ", "-")">@loan.Status</span></td><td><button class="btn btn-sm btn-light rounded-pill" data-demo-action="Knygos grąžinimas pažymėtas.">Grąžinti</button></td></tr>}</tbody></table></div></section>
