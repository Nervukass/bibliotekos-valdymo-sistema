@model LibraryBook
@{
    ViewData["Title"] = Model.Title;
    var isClient = Context.Session.GetString("LibraryRole") == LibraryRoles.Client;
}

<a class="back-link" asp-action="Catalog">← Grįžti į katalogą</a>
<section class="book-detail">
    <div class="book-cover large @Model.CoverClass"><span class="cover-rule"></span><small>@Model.Author</small><strong>@Model.Title</strong><i></i></div>
    <div class="book-detail-main">
        <span class="genre">@Model.Genre</span><h1>@Model.Title</h1><p class="book-author">@Model.Author</p>
        <div class="detail-meta"><span><small>Leidimo metai</small><strong>@Model.Year</strong></span><span><small>ISBN</small><strong>@Model.Isbn</strong></span><span><small>Lentyna</small><strong>@Model.Shelf</strong></span></div>
        <p class="description">@Model.Description</p>
        <div class="detail-actions">
            @if (Model.AvailableCopies > 0) { <button class="btn btn-dark rounded-pill px-4" data-demo-action="Rezervacija sėkmingai užregistruota.">Rezervuoti knygą</button> }
            else { <button class="btn btn-outline-dark rounded-pill px-4" data-demo-action="Jūsų prašymas įtrauktas į laukiančiųjų eilę.">Pranešti, kai bus</button> }
            @if (isClient && Model.Id == 1)
            {
                <a class="btn btn-outline-dark rounded-pill px-4" asp-action="Page" asp-route-id="review-create">Palikti atsiliepimą</a>
            }
            <a class="btn btn-link text-dark" asp-action="Catalog">Kitos knygos</a>
        </div>
    </div>
    <aside class="stock-card"><p>EGZEMPLIORIAI</p><strong>@Model.AvailableCopies <span>/ @Model.TotalCopies</span></strong><div class="stock-bar"><i style="width: @(Model.AvailableCopies * 100 / Model.TotalCopies)%"></i></div><small>@(Model.AvailableCopies > 0 ? "Galima išduoti šiandien" : "Visi egzemplioriai išduoti")</small></aside>
</section>
<section class="panel reviews-panel"><div class="panel-header"><div><h2>Skaitytojų atsiliepimai</h2><p>Šios knygos įvertinimas</p></div><strong class="rating">★ 4,7 <small>(18)</small></strong></div><div class="review"><div class="avatar">JR</div><div><strong>Justė R.</strong><span class="stars">★★★★★</span><p>Įtraukianti ir ilgai atmintyje išliekanti knyga.</p></div></div></section>
