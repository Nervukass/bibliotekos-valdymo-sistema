@model IEnumerable<WebApplication1.Models.ReaderViewModel>
@{ ViewData["Title"] = "Skaitytojai"; }
<div class="page-heading"><div><p class="eyebrow">SKAITYTOJŲ VALDYMAS</p><h1>Skaitytojai</h1><p class="page-subtitle">Peržiūrėkite registruotų skaitytojų informaciją.</p></div><button class="btn btn-dark rounded-pill px-4" data-demo-action="Naujo skaitytojo forma šiame demonstraciniame projekte nerodoma.">+ Naujas skaitytojas</button></div>
<section class="panel table-panel"><div class="table-tools"><div class="catalog-search compact"><span>⌕</span><input data-table-search type="search" placeholder="Ieškoti skaitytojo..." /></div><span class="book-count">Iš viso: <b>@Model.Count()</b></span></div><div class="table-responsive"><table><thead><tr><th>Skaitytojas</th><th>Kontaktai</th><th>Aktyvūs išdavimai</th><th>Būsena</th><th></th></tr></thead><tbody>@foreach (var reader in Model) { <tr data-searchable><td><div class="table-person"><div class="avatar">@reader.Initials</div><strong>@reader.Name</strong></div></td><td><strong>@reader.Email</strong><small>@reader.Phone</small></td><td>@reader.ActiveLoans</td><td><span class="status @(reader.Status == "Turi skolą" ? "pavėluota" : "aktyvus")">@reader.Status</span></td><td><button class="btn btn-sm btn-light rounded-pill" data-demo-action="Atidarytas skaitytojo profilis.">Peržiūrėti</button></td></tr>}</tbody></table></div></section>
