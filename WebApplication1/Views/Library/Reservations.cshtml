@model IEnumerable<WebApplication1.Models.ReservationViewModel>
@{ ViewData["Title"] = "Rezervacijos"; }
<div class="page-heading"><div><p class="eyebrow">KNYGŲ REZERVACIJOS</p><h1>Rezervacijos</h1><p class="page-subtitle">Valdykite skaitytojų laukiančias knygas.</p></div></div>
<section class="reservation-board">@foreach (var reservation in Model) { <article class="reservation-card"><div class="reservation-card-head"><span class="status @(reservation.Status == "Paruošta" ? "paruošta" : "laukia")">@reservation.Status</span><small>Prašymas: @reservation.RequestedOn</small></div><h2>@reservation.BookTitle</h2><div class="reader-line"><div class="avatar purple">@reservation.ReaderInitials</div><div><strong>@reservation.Reader</strong><span>@reservation.Queue</span></div></div><button class="btn @(reservation.Status == "Paruošta" ? "btn-dark" : "btn-outline-dark") w-100 rounded-pill" data-demo-action="Rezervacijos būsena atnaujinta.">@(reservation.Status == "Paruošta" ? "Pažymėti kaip atsiimtą" : "Paruošti atsiėmimui")</button></article> }</section>
